{
  "$comment": "Declarative SRE Agent configuration. Applied by scripts/configure-agent.sh. Tool grants are cross-checked against GET /api/v2/agent/tools because the API accepts unknown names silently.",
  "customInstructions": "custom-instructions.md",
  "githubMcpTools": [
    "issue_write",
    "issue_read",
    "list_issues",
    "search_issues",
    "add_issue_comment",
    "get_file_contents",
    "search_code",
    "list_commits",
    "get_commit",
    "assign_copilot_to_issue"
  ],
  "knowledgeBase": [
    "knowledge-base/contoso-trek-environment.md"
  ],
  "skills": [
    "skills/diagnose-trek-app-exception.md",
    "skills/repair-trek-inventory-config.md"
  ],
  "subagents": [
    {
      "name": "code-investigator",
      "handoffDescription": "Root-causes Contoso Trek HTTP 500 exceptions against source and files a GitHub issue. Has no Azure write tools.",
      "instructions": "instructions/code-investigator.md",
      "tools": [
        "SearchMemory",
        "SearchIncidentKnowledge",
        "QueryLogAnalyticsByWorkspaceId",
        "QueryAppInsightsByResourceId",
        "RunAzCliReadCommands",
        "FindConnectedGitHubRepo",
        "ListDir",
        "FileSearch",
        "GrepSearch",
        "ReadFile",
        "RunInTerminal",
        "github_issue_write",
        "github_issue_read",
        "github_search_issues",
        "github_add_issue_comment",
        "github_get_file_contents",
        "github_search_code",
        "github_list_commits",
        "github_assign_copilot_to_issue"
      ]
    },
    {
      "name": "platform-operator",
      "handoffDescription": "Repairs Contoso Trek Container App inventory configuration faults through the Azure CLI. Has no GitHub or terminal tools.",
      "instructions": "instructions/platform-operator.md",
      "tools": [
        "SearchMemory",
        "SearchIncidentKnowledge",
        "QueryLogAnalyticsByWorkspaceId",
        "QueryAppInsightsByResourceId",
        "RunAzCliReadCommands",
        "RunAzCliWriteCommands",
        "system-mcp-monitor_monitor_activitylog_list"
      ]
    }
  ],
  "responsePlans": [
    {
      "id": "trek-app-exception",
      "name": "Contoso Trek application exceptions",
      "titleContains": "app-exception",
      "handlingAgent": "code-investigator"
    },
    {
      "id": "trek-availability",
      "name": "Contoso Trek catalog availability",
      "titleContains": "availability",
      "handlingAgent": "platform-operator"
    }
  ]
}
